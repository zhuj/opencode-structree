{
  "name": "@local/object-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect-schema object registry and filesystem-authoritative MCP framework",
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./sqlite": "./src/lib/sqlite/public.ts",
    "./json-repair": "./src/lib/json-repair/index.ts",
    "./embeddings": "./src/lib/embeddings/index.ts",
    "./vault": "./src/lib/vault/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --target=bun --packages=external --outdir=dist",
    "start": "bun src/cli.ts serve --config object-mcp.config.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write .",
    "biome:check": "biome check . --error-on-warnings",
    "biome:fix": "biome check --write .",
    "smoke": "python3 scripts/smoke-stdio.py",
    "smoke:build": "bun run build && OBJECT_MCP_CLI=dist/cli.js bun run smoke",
    "check": "bun run biome:check && bun run typecheck && bun test && bun run smoke",
    "prepare-model": "bun scripts/prepare-model.ts --config object-mcp.config.json",
    "seed-example": "bun scripts/seed-example.ts --config object-mcp.config.json"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "effect": "4.0.5",
    "jsonrepair": "3.15.0",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "onnxruntime-node",
    "sharp"
  ]
}
