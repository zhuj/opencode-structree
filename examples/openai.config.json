{
  "root": "../.local/.structree/objects",
  "sqlite": { "path": "../.local/.structree/.cache/openai-index.sqlite" },
  "embeddings": {
    "provider": "openai",
    "model": "text-embedding-3-small",
    "dimensions": 1536,
    "baseUrl": "https://api.openai.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "batchSize": 32,
    "timeoutMs": 30000,
    "retries": 3,
    "maxInputBytes": 8000,
    "queryPrefix": "",
    "documentPrefix": ""
  }
}
