{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "*.json",
      "src/**/*.ts",
      "test/**/*.ts",
      "scripts/**/*.ts",
      "examples/**/*.ts",
      "examples/**/*.json",
      "!!**/node_modules",
      "!!**/.object-mcp",
      "!!**/objects",
      "!!**/models",
      "!!**/dist",
      "!!**/coverage",
      "!!package-lock.json",
      "!!bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["test/**/*.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
